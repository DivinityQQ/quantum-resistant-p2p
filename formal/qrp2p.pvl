(* QRP2P v2: shared declarations and the honest processes for the ProVerif models.

   Loaded as a library by every model in this directory:
       proverif -lib formal/qrp2p formal/<model>.pv
   (formal/verify.py does this and checks each result against the EXPECT lines in the model).

   What is modelled (DESIGN §4, §7, §8.4)
   - The four-message handshake (Hello, Reply, Confirm, Admit) with the exact transcript entries of
     §7.3 and the key schedule of §7.4, and the signed PQ rekey of §8.4.
   - X-Wing as two component KEMs ("M" for ML-KEM-768, "X" for X25519) joined by the combiner, so
     a model can break one component and check that secrecy survives.

   Simplifications (each is sound for the properties queried, or noted where it is not)
   - Symbolic (Dolev-Yao) cryptography: perfect KEMs, signatures, hash, HKDF, HMAC and AEAD.
   - The hybrid signature is one signature scheme. Its two halves are not modelled separately.
   - Profiles are opaque values chosen by the initiator. Both profiles use the X-Wing model; the
     ML-KEM-1024 profile's binding properties are left to the Tamarin cross-check (M6).
   - Keys(S) is one symbolic key; the AEAD nonce is the sequence number; the frame header (AAD) is
     a constant per message type. Sizes and encodings are not modelled.
   - The admission decision and the glass-box grant are chosen by the attacker, which covers every
     choice a user can make. The core enforces "glass_box only if requested"; so does the model.
   - Reflection checks (§7.5) are local policy and are not modelled. *)

free c: channel.

type kseed.
type sseed.

(* ---- KEM: X-Wing = ML-KEM-768 ("M") + X25519 ("X") + combiner (DESIGN §4.2) --------------------- *)

fun pkM(kseed): bitstring.
fun pkX(kseed): bitstring.
fun ctM(bitstring, bitstring): bitstring.  (* ctM(ek, coins) *)
fun ssM(bitstring, bitstring): bitstring.  (* ssM(ek, coins) *)
fun ctX(bitstring, bitstring): bitstring.
fun ssX(bitstring, bitstring): bitstring.
reduc forall s: kseed, r: bitstring; decM(s, ctM(pkM(s), r)) = ssM(pkM(s), r).
reduc forall s: kseed, r: bitstring; decX(s, ctX(pkX(s), r)) = ssX(pkX(s), r).

(* ss = SHA3-256(ssM ‖ ssX ‖ ctX ‖ pkX ‖ label) *)
fun combine(bitstring, bitstring, bitstring, bitstring): bitstring.

(* ---- Signatures (HybridSign, DESIGN §4.4) ---------------------------------------------------- *)

fun spk(sseed): bitstring.
fun sign(sseed, bitstring): bitstring.
reduc forall s: sseed, m: bitstring; checksign(spk(s), m, sign(s, m)) = true.
reduc forall s: sseed, m: bitstring; getmess(sign(s, m)) = m.  (* signatures hide nothing *)

(* ---- Hash, HKDF, HMAC, AEAD ------------------------------------------------------------------ *)

fun H(bitstring): bitstring.
fun hextract(bitstring, bitstring): bitstring.          (* HKDF-Extract(salt, ikm) *)
fun hexpand(bitstring, bitstring, bitstring): bitstring. (* Expand-Label(S, label, ctx) *)
fun hmac(bitstring, bitstring): bitstring.
fun aenc(bitstring, bitstring, bitstring, bitstring): bitstring.  (* aenc(key, seq, aad, pt) *)
reduc forall k: bitstring, n: bitstring, a: bitstring, m: bitstring;
  adec(k, n, a, aenc(k, n, a, m)) = m.

(* Records with an explicit keystream, for the nonce-reuse model (record*.pv). seal(z, m) stands for
   "m XOR keystream z plus a tag": two ciphertexts under one keystream and one known plaintext give
   the other plaintext. *)
fun ks(bitstring, bitstring): bitstring.  (* ks(key, nonce) *)
fun seal(bitstring, bitstring): bitstring.
reduc forall k: bitstring, n: bitstring, m: bitstring; sopen(k, n, seal(ks(k, n), m)) = m.
reduc forall z: bitstring, m1: bitstring, m2: bitstring; recover(seal(z, m1), seal(z, m2), m1) = m2.

(* ---- Constants ------------------------------------------------------------------------------- *)

const cZero: bitstring.   (* 0^Hlen *)
const cEmpty: bitstring.  (* "" *)
const v2: bitstring.      (* Hello version 0x02 *)
const gbOn: bitstring.
const gbOff: bitstring.
const accept: bitstring.

(* Transcript tags (DESIGN §7.3, §8.4) *)
const t10: bitstring.
const t11: bitstring.
const t21: bitstring.
const t22: bitstring.
const t23: bitstring.
const t31: bitstring.
const t32: bitstring.
const t33: bitstring.
const t41: bitstring.
const t42: bitstring.
const t51: bitstring.
const t52: bitstring.
const t53: bitstring.
const t54: bitstring.

(* Key-schedule labels (DESIGN §7.4) *)
const lRhs: bitstring.      (* "r hs traffic" *)
const lIhs: bitstring.      (* "i hs traffic" *)
const lFin: bitstring.      (* "finished" *)
const lDerived: bitstring.  (* "derived" *)
const lIap: bitstring.      (* "i ap traffic" *)
const lRap: bitstring.      (* "r ap traffic" *)
const lKey: bitstring.      (* Keys(S) *)
const lExporter: bitstring. (* "exporter" *)
const lUpdate: bitstring.   (* "traffic upd" *)

(* Signature roles (DESIGN §4.4) *)
const rResponder: bitstring.
const rInitiator: bitstring.
const rRekeyAnswer: bitstring.
const rRekeyFinish: bitstring.

(* Frame headers used as AAD, and sequence numbers *)
const hReply: bitstring.
const hConfirm: bitstring.
const hAdmit: bitstring.
const hRecord: bitstring.
const s0: bitstring.
const s1: bitstring.

(* ---- Secrets, honesty, events ---------------------------------------------------------------- *)

free secretI: bitstring [private].      (* first record from the initiator, under ap_I *)
free secretR: bitstring [private].      (* first record from the responder, under ap_R *)
free secretRekey: bitstring [private].  (* first record under a key from a PQ rekey *)
free secretMsg: bitstring [private].    (* a record in the record-layer models *)
free updatePastI: bitstring [private].
free updatePastR: bitstring [private].
free updateIntermediate: bitstring [private].
free updateCurrent: bitstring [private].

(* KeyUpdate erasure regression: compromise both current directions, the exporter and the
   precomputed next-rekey salt after two updates. No root or obsolete traffic secret is leaked
   in the honest state. The two regression models deliberately retain one of those ancestors.
   This models logical reference erasure, not Python physical memory zeroization. *)
let KeyUpdateCompromise(keepRoot: bool, keepTraffic: bool) =
  new cs: bitstring;
  new th: bitstring;
  let salt = hexpand(cs, lDerived, H(cEmpty)) in
  let exp = hexpand(cs, lExporter, th) in
  let apI0 = hexpand(cs, lIap, th) in
  let apR0 = hexpand(cs, lRap, th) in
  let apI1 = hexpand(apI0, lUpdate, cEmpty) in
  let apR1 = hexpand(apR0, lUpdate, cEmpty) in
  let apI2 = hexpand(apI1, lUpdate, cEmpty) in
  let apR2 = hexpand(apR1, lUpdate, cEmpty) in
  out(c, (th, salt, exp, apI2, apR2,
          aenc(hexpand(apI0, lKey, cEmpty), s0, hRecord, updatePastI),
          aenc(hexpand(apR0, lKey, cEmpty), s0, hRecord, updatePastR),
          aenc(hexpand(apI1, lKey, cEmpty), s0, hRecord, updateIntermediate),
          aenc(hexpand(apI2, lKey, cEmpty), s0, hRecord, updateCurrent)));
  (if keepRoot = true then out(c, cs)) |
  (if keepTraffic = true then out(c, (apI0, apR0))).

(* Identities that belong to honest users. The attacker has identities of its own, which honest
   users will talk to; properties are stated for sessions whose peer is in this table. *)
table honest(bitstring).

(* Arguments: pk_I, pk_R, profile, gb_request, and then the admit body and transcript hash. *)
event IConfirmSent(bitstring, bitstring, bitstring, bitstring, bitstring).
event RConfirmOk(bitstring, bitstring, bitstring, bitstring, bitstring).
event RAdmitSent(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event IAdmitOk(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event RKeyConfirmed(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event IDone.
event RDone.

(* ---- The handshake (DESIGN §7) --------------------------------------------------------------- *)

(* The initiator. Its user picks the profile, the glass-box request and, when connecting to a
   contact, the pinned bundle; the attacker makes all of these choices. *)
let Initiator(skI: sseed, pkI: bitstring) =
  in(c, (prof: bitstring, gbreq: bitstring, hasPin: bool, pinned: bitstring));
  new eseed: kseed;
  new nI: bitstring;
  let ekI = (pkM(eseed), pkX(eseed)) in
  let hello = (v2, prof, gbreq, nI, ekI) in
  out(c, hello);
  (* Reply *)
  in(c, (nR: bitstring, ctm: bitstring, ctx: bitstring, rbox: bitstring));
  let ss = combine(decM(eseed, ctm), decX(eseed, ctx), ctx, pkX(eseed)) in
  let hs = hextract(cZero, ss) in
  let tr1 = ((t10, hello), (t11, (nR, (ctm, ctx)))) in
  let hsR = hexpand(hs, lRhs, H(tr1)) in
  let hsI = hexpand(hs, lIhs, H(tr1)) in
  let (idR: bitstring, sigR: bitstring, finR: bitstring) = adec(hexpand(hsR, lKey, cEmpty), s0, hReply, rbox) in
  let tr2 = (tr1, (t21, idR)) in
  if checksign(idR, (rResponder, H(tr2)), sigR) = true then
  let tr3 = (tr2, (t22, sigR)) in
  if finR = hmac(hexpand(hsR, lFin, cEmpty), H(tr3)) then
  (* the pin is checked before the initiator reveals itself *)
  if hasPin = false || idR = pinned then
  (* Confirm *)
  let tr4 = ((tr3, (t23, finR)), (t31, pkI)) in
  let sigI = sign(skI, (rInitiator, H(tr4))) in
  let tr5 = (tr4, (t32, sigI)) in
  let finI = hmac(hexpand(hsI, lFin, cEmpty), H(tr5)) in
  let tr6 = (tr5, (t33, finI)) in
  event IConfirmSent(pkI, idR, prof, gbreq, H(tr6));
  out(c, aenc(hexpand(hsI, lKey, cEmpty), s0, hConfirm, (pkI, sigI, finI)));
  (* Admit *)
  in(c, abox: bitstring);
  let (admitBody: bitstring, finA: bitstring) = adec(hexpand(hsR, lKey, cEmpty), s1, hAdmit, abox) in
  let tr7 = (tr6, (t41, admitBody)) in
  if finA = hmac(hexpand(hsR, lFin, cEmpty), H(tr7)) then
  let thf = H((tr7, (t42, finA))) in
  let (dec: bitstring, gbflag: bitstring, reason: bitstring) = admitBody in
  get honest(=idR) in
  event IAdmitOk(pkI, idR, prof, gbreq, admitBody, thf);
  if dec = accept then
  let cs0 = hextract(hexpand(hs, lDerived, H(cEmpty)), cZero) in
  let apI = hexpand(cs0, lIap, thf) in
  event IDone;
  out(c, aenc(hexpand(apI, lKey, cEmpty), s0, hRecord, secretI)).

(* The responder after a verified Confirm: admission (DESIGN §7.6), then Admit. *)
let ResponderAdmit(pkR: bitstring, idI: bitstring, prof: bitstring, gbreq: bitstring,
                   hs: bitstring, hsR: bitstring, tr6: bitstring, honestPeer: bool,
                   dec: bitstring, gbflag: bitstring, reason: bitstring) =
  let admitBody = (dec, gbflag, reason) in
  let tr7 = (tr6, (t41, admitBody)) in
  let finA = hmac(hexpand(hsR, lFin, cEmpty), H(tr7)) in
  let thf = H((tr7, (t42, finA))) in
  event RAdmitSent(idI, pkR, prof, gbreq, admitBody, thf);
  out(c, aenc(hexpand(hsR, lKey, cEmpty), s1, hAdmit, (admitBody, finA)));
  if dec = accept then
  let cs0 = hextract(hexpand(hs, lDerived, H(cEmpty)), cZero) in
  let apI = hexpand(cs0, lIap, thf) in
  let apR = hexpand(cs0, lRap, thf) in
  if honestPeer = true then
  event RDone;
  out(c, aenc(hexpand(apR, lKey, cEmpty), s0, hRecord, secretR));
  (* The first record from the initiator confirms that it derived the same keys. *)
  in(c, rec: bitstring);
  let first = adec(hexpand(apI, lKey, cEmpty), s0, hRecord, rec) in
  event RKeyConfirmed(idI, pkR, prof, gbreq, admitBody, thf).

let ResponderDecide(pkR: bitstring, idI: bitstring, prof: bitstring, gbreq: bitstring,
                    hs: bitstring, hsR: bitstring, tr6: bitstring, honestPeer: bool) =
  in(c, (dec: bitstring, grant: bool, reason: bitstring));
  (* glass_box = 1 only if the initiator asked for it *)
  if grant = true && gbreq = gbOn then
    ResponderAdmit(pkR, idI, prof, gbreq, hs, hsR, tr6, honestPeer, dec, gbOn, reason)
  else
    ResponderAdmit(pkR, idI, prof, gbreq, hs, hsR, tr6, honestPeer, dec, gbOff, reason).

let Responder(skR: sseed, pkR: bitstring) =
  (* Hello *)
  in(c, hello: bitstring);
  let (=v2, prof: bitstring, gbreq: bitstring, nI: bitstring, ekI: bitstring) = hello in
  let (ekM: bitstring, ekX: bitstring) = ekI in
  (* Reply *)
  new rM: bitstring;
  new rX: bitstring;
  new nR: bitstring;
  let ctm = ctM(ekM, rM) in
  let ctx = ctX(ekX, rX) in
  let ss = combine(ssM(ekM, rM), ssX(ekX, rX), ctx, ekX) in
  let hs = hextract(cZero, ss) in
  let tr1 = ((t10, hello), (t11, (nR, (ctm, ctx)))) in
  let hsR = hexpand(hs, lRhs, H(tr1)) in
  let hsI = hexpand(hs, lIhs, H(tr1)) in
  let tr2 = (tr1, (t21, pkR)) in
  let sigR = sign(skR, (rResponder, H(tr2))) in
  let tr3 = (tr2, (t22, sigR)) in
  let finR = hmac(hexpand(hsR, lFin, cEmpty), H(tr3)) in
  out(c, (nR, ctm, ctx, aenc(hexpand(hsR, lKey, cEmpty), s0, hReply, (pkR, sigR, finR))));
  (* Confirm *)
  in(c, cbox: bitstring);
  let (idI: bitstring, sigI: bitstring, finI: bitstring) = adec(hexpand(hsI, lKey, cEmpty), s0, hConfirm, cbox) in
  let tr4 = ((tr3, (t23, finR)), (t31, idI)) in
  if checksign(idI, (rInitiator, H(tr4)), sigI) = true then
  let tr5 = (tr4, (t32, sigI)) in
  if finI = hmac(hexpand(hsI, lFin, cEmpty), H(tr5)) then
  let tr6 = (tr5, (t33, finI)) in
  get honest(=idI) in (
    event RConfirmOk(idI, pkR, prof, gbreq, H(tr6));
    ResponderDecide(pkR, idI, prof, gbreq, hs, hsR, tr6, true)
  ) else
    ResponderDecide(pkR, idI, prof, gbreq, hs, hsR, tr6, false).

(* ---- The signed PQ rekey (DESIGN §8.4) ------------------------------------------------------- *)

(* exporter_n = Derive-Secret(cs_n, "exporter", th): th_final covers both identity bundles, so an
   exporter belongs to one session between two identities. Modelled as expo(pk_I, pk_R, session). *)
fun expo(bitstring, bitstring, bitstring): bitstring.

event RAnswered(bitstring, bitstring, bitstring).  (* pk_I, pk_R, H(RT) *)
event IAnswerOk(bitstring, bitstring, bitstring).
event IRekeyed(bitstring, bitstring, bitstring).   (* pk_I, pk_R, th_rekey *)
event RRekeyed(bitstring, bitstring, bitstring).
event IRekeyDone.
event RRekeyDone.

(* cs and exp are the session's chaining secret cs_n and exporter_n. The rekey messages travel as
   records; the models give the attacker those record keys, so they are sent in the clear. *)
let RekeyInitiator(skI: sseed, pkI: bitstring, pkR: bitstring, cs: bitstring, exp: bitstring,
                   honestSession: bool) =
  new eseed: kseed;
  let ek = (pkM(eseed), pkX(eseed)) in
  out(c, ek);  (* rekey_offer *)
  in(c, (ctm: bitstring, ctx: bitstring, sigR: bitstring));  (* rekey_answer *)
  let ss = combine(decM(eseed, ctm), decX(eseed, ctx), ctx, pkX(eseed)) in
  let rt = ((t51, ek), (t52, (ctm, ctx))) in
  if checksign(pkR, (rRekeyAnswer, H((rt, exp))), sigR) = true then
  let sigI = sign(skI, (rRekeyFinish, H(((rt, (t53, sigR)), exp)))) in
  let th = H(((rt, (t53, sigR)), (t54, sigI))) in
  event IRekeyed(pkI, pkR, th);
  out(c, sigI);  (* rekey_finish *)
  let cs1 = hextract(hexpand(cs, lDerived, H(cEmpty)), ss) in
  let apI = hexpand(cs1, lIap, th) in
  get honest(=pkR) in
  event IAnswerOk(pkI, pkR, H(rt));
  if honestSession = true then
  event IRekeyDone;
  out(c, aenc(hexpand(apI, lKey, cEmpty), s0, hRecord, secretRekey)).

let RekeyResponder(skR: sseed, pkR: bitstring, pkI: bitstring, cs: bitstring, exp: bitstring,
                   honestSession: bool) =
  in(c, ek: bitstring);  (* rekey_offer *)
  let (ekM: bitstring, ekX: bitstring) = ek in
  new rM: bitstring;
  new rX: bitstring;
  let ctm = ctM(ekM, rM) in
  let ctx = ctX(ekX, rX) in
  let ss = combine(ssM(ekM, rM), ssX(ekX, rX), ctx, ekX) in
  let rt = ((t51, ek), (t52, (ctm, ctx))) in
  let sigR = sign(skR, (rRekeyAnswer, H((rt, exp)))) in
  event RAnswered(pkI, pkR, H(rt));
  out(c, (ctm, ctx, sigR));  (* rekey_answer *)
  in(c, sigI: bitstring);  (* rekey_finish *)
  if checksign(pkI, (rRekeyFinish, H(((rt, (t53, sigR)), exp))), sigI) = true then
  let th = H(((rt, (t53, sigR)), (t54, sigI))) in
  let cs1 = hextract(hexpand(cs, lDerived, H(cEmpty)), ss) in
  let apR = hexpand(cs1, lRap, th) in
  get honest(=pkI) in
  event RRekeyed(pkI, pkR, th);
  if honestSession = true then
  event RRekeyDone;
  out(c, aenc(hexpand(apR, lKey, cEmpty), s0, hRecord, secretRekey)).

(* WEAKENED ENGINE (DESIGN §11.8): AEAD nonce reuse. Every record is sealed with the same nonce.
   Expected attack: keystream recovery. With one known plaintext (a ping) the attacker reads the
   secret record. (The concrete lab engine also forges records; the symbolic model shows the
   confidentiality half.) Otherwise the same as formal/record.pv. *)

const n0: bitstring.
const n1: bitstring.
const ping: bitstring.

event Sent(bitstring, bitstring, bitstring).  (* key, sequence number, plaintext *)
event Recv(bitstring, bitstring, bitstring).
event RecvDone.

let Sender(k: bitstring) =
  event Sent(k, n0, ping);
  out(c, seal(ks(k, n0), ping));
  event Sent(k, n0, secretMsg);
  out(c, seal(ks(k, n0), secretMsg)).  (* WEAKENED: nonce n0 again *)

let Receiver(k: bitstring) =
  in(c, r0: bitstring);
  let m0 = sopen(k, n0, r0) in
  event Recv(k, n0, m0);
  in(c, r1: bitstring);
  let m1 = sopen(k, n0, r1) in  (* WEAKENED *)
  event Recv(k, n0, m1);
  event RecvDone.

(* EXPECT false: not event(RecvDone) *)
query event(RecvDone).
(* EXPECT false: not attacker(secretMsg *)
query attacker(secretMsg).
(* EXPECT false: inj-event(Recv *)
query k: bitstring, n: bitstring, m: bitstring; inj-event(Recv(k, n, m)) ==> inj-event(Sent(k, n, m)).

process
  !( new k: bitstring; ( Sender(k) | Receiver(k) ) )

(* WEAKENED ENGINE (DESIGN §11.8): sequence numbers travel with the record and replays are
   filtered by a small dedup set. Once an entry is evicted, a replay is accepted again; the model
   abstracts the eviction by keeping no set at all. Expected attack (Attack Lab scenario 5): a
   record is accepted twice. Otherwise the same as formal/record.pv. *)

const n0: bitstring.
const n1: bitstring.
const ping: bitstring.

event Sent(bitstring, bitstring, bitstring).  (* key, sequence number, plaintext *)
event Recv(bitstring, bitstring, bitstring).
event RecvDone.

let Sender(k: bitstring) =
  event Sent(k, n0, ping);
  out(c, (n0, seal(ks(k, n0), ping)));  (* WEAKENED: the sequence number is sent *)
  event Sent(k, n1, secretMsg);
  out(c, (n1, seal(ks(k, n1), secretMsg))).

(* WEAKENED: any record that opens under the sequence number it carries is accepted *)
let Receiver(k: bitstring) =
  !( in(c, (n: bitstring, r: bitstring));
     let m = sopen(k, n, r) in
     event Recv(k, n, m);
     event RecvDone ).

(* EXPECT false: not event(RecvDone) *)
query event(RecvDone).
(* EXPECT true: not attacker(secretMsg *)
query attacker(secretMsg).
(* EXPECT false: inj-event(Recv *)
query k: bitstring, n: bitstring, m: bitstring; inj-event(Recv(k, n, m)) ==> inj-event(Sent(k, n, m)).

process
  !( new k: bitstring; ( Sender(k) | Receiver(k) ) )
